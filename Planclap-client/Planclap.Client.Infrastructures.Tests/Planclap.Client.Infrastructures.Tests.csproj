<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7"/>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0"/>
    <PackageReference Include="NSubstitute" Version="5.3.0"/>
    <PackageReference Include="NUnit" Version="4.4.0"/>
    <PackageReference Include="NUnit.Analyzers" Version="4.10.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0"/>
    <PackageReference Include="ReportGenerator" Version="5.4.3"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Planclap.Client.Domains\Planclap.Client.Domains.csproj"/>
    <ProjectReference Include="..\Planclap.Client.Infrastructures\Planclap.Client.Infrastructures.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Remove="movies.json"/>
  </ItemGroup>
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura,opencover</CoverletOutputFormat>
    <CoverletOutput>./TestResults/coverage</CoverletOutput>
  </PropertyGroup>
  <PropertyGroup>
    <UserDir>$(HOMEDRIVE)$(HOMEPATH)/.nuget/packages/reportgenerator/5.4.3/tools/net8.0</UserDir>
  </PropertyGroup>
  <Target Name="GenerateCoverageReport" AfterTargets="VSTest">
    <Exec Command="$(UserDir)/ReportGenerator.exe -reports:$(MSBuildProjectDirectory/../TestResults/**/coverage.cobertura.xml -targetdir:$(MSBuildProjectDirectory)/../../CoverageReport -reporttypes:Html"/>
  </Target>
</Project>
